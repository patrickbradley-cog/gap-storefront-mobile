{
  "name": "gap-storefront-mobile",
  "version": "0.1.0",
  "private": true,
  "scripts": {
    "dev": "next dev --turbopack",
    "build": "next build --turbopack",
    "start": "next start",
    "lint": "eslint",
    "typecheck": "tsc --noEmit",
    "db:up": "docker compose up -d db",
    "db:seed": "tsx src/server/db/seed.ts",
    "db:setup": "npm run db:up && npm run db:seed",
    "images:generate": "tsx scripts/generate-images.ts",
    "demo": "docker compose up --build",
    "test:mobile": "playwright test --project=mobile-safari-iphone15",
    "test:desktop": "playwright test --project=desktop-chromium",
    "test:all": "playwright test",
    "test:ios": "tsx tests/ios/run-ios-checkout.ts",
    "ios:sync": "cap sync ios",
    "ios:build": "cap sync ios && xcodebuild -project ios/App/App.xcodeproj -scheme App -configuration Debug -sdk iphonesimulator -destination 'generic/platform=iOS Simulator' -derivedDataPath ios/build CODE_SIGNING_ALLOWED=NO build -quiet",
    "ios:run": "tsx scripts/ios-sim.ts"
  },
  "dependencies": {
    "dotenv": "^18.0.8",
    "next": "15.5.28",
    "pg": "^8.23.1",
    "react": "19.1.0",
    "react-dom": "19.1.0"
  },
  "devDependencies": {
    "@capacitor/cli": "^8.5.3",
    "@capacitor/core": "^8.5.3",
    "@capacitor/ios": "^8.5.3",
    "@eslint/eslintrc": "^3",
    "@playwright/test": "^1.64.1",
    "@tailwindcss/postcss": "^4",
    "@types/node": "^20",
    "@types/pg": "^8.23.1",
    "@types/react": "^19",
    "@types/react-dom": "^19",
    "eslint": "^9",
    "eslint-config-next": "15.5.28",
    "tailwindcss": "^4",
    "tsx": "^4.23.15",
    "typescript": "^5",
    "webdriverio": "^9.32.0"
  }
}
